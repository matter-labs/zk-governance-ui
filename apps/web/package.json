{
  "name": "web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "author": "moonsong-labs",
  "license": "(MIT OR Apache-2.0)",
  "scripts": {
    "build": "vite build --config standalone/vite.config.ts && node standalone/inline.mjs",
    "build:sepolia-test": "vite build --config standalone/sepolia-test/vite.config.ts && node standalone/inline.mjs standalone/sepolia-test/dist verifier-sepolia-test.html",
    "build:ecosystem": "vite build --config standalone/ecosystems/vite.config.ts && node standalone/inline.mjs standalone/ecosystems/dist-$ECOSYSTEM verifier-$ECOSYSTEM.html",
    "typecheck": "tsc --noEmit",
    "test": "run-s test:u test:s",
    "test:u": "vitest run --config ./vitest.unit.config.ts",
    "test:s": "vitest run --config ./vitest.server.config.ts",
    "test:i": "vitest run --config ./vitest.integration.config.ts",
    "test:fork": "vitest run --config ./vitest.fork.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "=1.1.4",
    "@radix-ui/react-label": "=2.1.1",
    "@radix-ui/react-progress": "=1.1.1",
    "@radix-ui/react-separator": "=1.1.1",
    "@radix-ui/react-slot": "=1.1.1",
    "@rainbow-me/rainbowkit": "=2.2.2",
    "@remix-run/node": "=2.16.0",
    "@remix-run/react": "=2.16.0",
    "@repo/common": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@t3-oss/env-core": "=0.10.1",
    "@tanstack/react-query": "=5.55.4",
    "class-variance-authority": "=0.7.0",
    "clsx": "=2.1.1",
    "dotenv": "^16.4.5",
    "lucide-react": "=0.399.0",
    "pino": "=9.2.0",
    "react": "=19.0.0",
    "react-dom": "=19.0.0",
    "react-hot-toast": "=2.5.1",
    "react-router-dom": "6.30.0",
    "tailwind-merge": "=2.6.0",
    "tailwindcss-animate": "=1.0.7",
    "viem": "=2.22.9",
    "wagmi": "=2.14.8",
    "zod": "=3.24.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.3.2",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "jsdom": "^24.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "5.5.4",
    "vite": "^5.3.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^2.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
